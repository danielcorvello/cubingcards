[{"_1":2,"_3":4},"root",{"_5":118},"routes/conteudo-do-cubo",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24},"tipo","metodo","cubo",{"_11":116,"_13":26,"_27":117},"id","top-first","nome","Top-first","nomeLongo","Top-first (por camadas e L4E)","niveis",[85,47],"introducao","<p>O jeito de montar o Pyraminx pela primeira vez: por camadas, com o amarelo embaixo. Pontas e centros quase de graça, as 3 arestas de baixo com duas fórmulas de 3 movimentos e as 3 de cima com 5 casos. Abra cada passo com o Pyraminx na mão.</p>\n","etapas",[31,32,33,34],"historias",[25],{"_13":26,"_27":28,"_29":30},"Pyraminx","endereco","/historia#pyraminx","resumo","O tetraedro foi criado e patenteado por Uwe Mèffert e lançado pela japonesa Tomy em 1981, no auge do cubo mágico.",{"_11":110,"_13":111,"_37":112,"_39":113,"_41":114,"_42":-7},{"_11":104,"_13":105,"_37":106,"_39":107,"_41":108,"_42":-7},{"_11":75,"_13":76,"_37":77,"_39":78,"_41":79,"_42":80},{"_11":35,"_13":36,"_37":38,"_39":40,"_41":-7,"_42":43},"l4e","Mais rápido: L4E","html","<p>Em vez da camada inteira, monte só o &quot;V&quot; (as 2 arestas de baixo que não estão na frente) e resolva as 4 últimas arestas de uma vez, com os cartões do L4E e os outros 10 do L3E.</p>\n","grupos",[44],"pagina","treino","/pyraminx/treino?grupo=l4e",{"_11":45,"_13":45,"_46":47,"_48":49,"_50":51,"_52":53,"_27":54},"Pyraminx L4E","nivel","intermediario","casos",20,"conjunto",false,"ids",[55,56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74],"/pyraminx/l4e","PYRA-RightPolishFlip","PYRA-LeftPolishFlip","PYRA-SUS","PYRA-AntiSUS","PYRA-GoodNiky","PYRA-GoodSochi","PYRA-SuperSledge","PYRA-SuperHedge","PYRA-BadNiky","PYRA-BadSochi","PYRA-RightSpam","PYRA-LeftSpam","PYRA-BadSledge","PYRA-BadHedge","PYRA-BadSexy","PYRA-BadUgly","PYRA-BadRighty","PYRA-BadLefty","PYRA-DoubleSexy","PYRA-DoubleUgly","l3e","Última camada (L3E)","<p>As 3 arestas de cima: 5 casos, um cartão para cada.</p>\n",[83],{"_13":81,"_27":82},"/pyraminx/treino?grupo=l3e","Última camada","/pyraminx/ultima-camada",{"_11":84,"_13":84,"_46":85,"_48":86,"_50":51,"_52":87,"_27":88},"Pyraminx L3E","iniciante",15,[89,90,91,92,93,94,95,96,97,98,99,100,101,102,103],"/pyraminx/l3e","PYRA-Sune","PYRA-AntiSune","PYRA-LeftyBars","PYRA-RightyBars","PYRA-Sledge","PYRA-Hedge","PYRA-Clockwise","PYRA-Counterclockwise","PYRA-Righty","PYRA-Lefty","PYRA-Sexy","PYRA-LeftSexy","PYRA-2Flip","PYRA-DRFlip","PYRA-4Flip","primeira-camada","1ª camada","<p>As 3 arestas de baixo, com <code>R U R&#39;</code> ou o espelho dela, <code>L&#39; U&#39; L</code>.</p>\n",[],{"_13":105,"_27":109},"/pyraminx/primeira-camada","pontas-e-centros","Pontas e centros","<p>As pontas giram sozinhas e os centros só giram no lugar: poucos giros, sem fórmula.</p>\n",[],{"_13":111,"_27":115},"/pyraminx/pontas-e-centros","pyraminx","/pyraminx/",{"_119":120},"cubos",[121,122,123,124,125,126],{"_11":132,"_13":132},{"_11":131,"_13":131},{"_11":130,"_13":130},{"_11":129,"_13":129},{"_11":127,"_13":128},{"_11":116,"_13":26},"megaminx","Megaminx","5x5","4x4","2x2","3x3"]
