[{"_1":2,"_3":4},"root",{"_5":88},"routes/notacao",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20},"cubo",{"_84":85,"_21":86,"_23":87},"introducao","O Skewb gira em volta dos cantos: cada giro mexe metade dele (um canto, os 3 cantos vizinhos e 3 centros), 1/3 de volta. O apóstrofo (') inverte o sentido.","comoSegurar","<p>Segure com a 1ª camada embaixo e o amarelo em cima, como nas fórmulas dos cartões.</p>\n<ul>\n<li><strong>As letras são os cantos de cima:</strong> R é o da frente à direita, F o da frente à esquerda, L o de trás à esquerda e B o de trás à direita. O giro mexe a metade do Skewb que contém o canto.</li>\n<li><strong>O sentido:</strong> horário é olhando para o canto de fora, como se ele apontasse para você. O apóstrofo (&#39;) inverte.</li>\n<li><strong>Sem o 2:</strong> cada giro é 1/3 de volta (120°). Dois giros para um lado dão no mesmo que um para o outro (R R é o mesmo que R&#39;).</li>\n<li><strong>Os dois <a href=\"/glossario#trigger\" class=\"termo-do-glossario\" title=\"Sequência curta que aparece em muitas fórmulas (R U R' U', Sledge…). Decorar os triggers deixa as fórmulas longas mais fáceis.\">triggers</a>:</strong> o <a href=\"/glossario#sledgehammer\" class=\"termo-do-glossario\" title=\"Dois triggers: o sledgehammer é R' F R F' e o hedgeslammer, F R' F' R. No Skewb, os dois montam quase todas as fórmulas do método da Sarah.\">sledgehammer</a> é R&#39; F R F&#39;; o hedgeslammer, F R&#39; F&#39; R. Quase todas as fórmulas do <a href=\"/glossario#sarah\" class=\"termo-do-glossario\" title=\"Método de Skewb da Sarah Strong, feito de sledgehammers e hedgeslammers: a 1ª camada, a face de cima (Intermediate, 10 casos) e os centros;…\">método da Sarah</a> são feitas deles.</li>\n</ul>\n<p>Os <a href=\"/glossario#embaralhamento\" class=\"termo-do-glossario\" title=\"Sequência de movimentos que bagunça o cubo antes de resolver. Nas competições, todos recebem o mesmo.\">embaralhamentos</a> usam outra <a href=\"/glossario#notacao\" class=\"termo-do-glossario\" title=\"As letras que descrevem os movimentos: R, U, F… Cada cubo tem a página de notação dele.\">notação</a>, a da <a href=\"/glossario#wca\" class=\"termo-do-glossario\" title=\"A associação que organiza as competições oficiais e guarda os recordes.\">WCA</a>: com o branco em cima e o verde na frente, R, U, L e B giram em volta de 4 cantos que não saem do lugar (R: embaixo, atrás, à direita; U: em cima, atrás, à esquerda; L: embaixo, na frente, à esquerda; B: embaixo, atrás, à esquerda).</p>\n","basicos",[52,53,54,55,56,57,58,59],"outros",[25,26,27,28,29,30],"treino","/skewb/treino/notacao","metodo",{"_21":22,"_23":24},"nome","Sarah's Intermediate","endereco","/skewb/sarah",{"_31":49,"_33":50,"_35":51,"_37":38},{"_31":47,"_33":34,"_35":48,"_37":38},{"_31":44,"_33":45,"_35":46,"_37":38},{"_31":42,"_33":34,"_35":43,"_37":38},{"_31":39,"_33":40,"_35":41,"_37":38},{"_31":32,"_33":34,"_35":36,"_37":38},"movimento","z'","descricao","Vire o Skewb inteiro no sentido contrário.","imagem","/imagens/notacao/skewb/14.svg","meiaVolta",false,"z","Vire o Skewb inteiro como o F do 3x3 (a face de cima vai para a direita).","/imagens/notacao/skewb/13.svg","y'","/imagens/notacao/skewb/12.svg","y","Vire o Skewb inteiro como o U do 3x3 (a face da direita vem para a frente).","/imagens/notacao/skewb/11.svg","x'","/imagens/notacao/skewb/10.svg","x","Vire o Skewb inteiro como o R do 3x3 (a frente vai para cima).","/imagens/notacao/skewb/9.svg",{"_31":81,"_33":82,"_35":83,"_37":38},{"_31":78,"_33":79,"_35":80,"_37":38},{"_31":75,"_33":76,"_35":77,"_37":38},{"_31":72,"_33":73,"_35":74,"_37":38},{"_31":69,"_33":70,"_35":71,"_37":38},{"_31":66,"_33":67,"_35":68,"_37":38},{"_31":63,"_33":64,"_35":65,"_37":38},{"_31":60,"_33":61,"_35":62,"_37":38},"L'","Metade do Skewb em volta do canto de cima atrás, à esquerda: 1/3 de volta (120°) no sentido anti-horário.","/imagens/notacao/skewb/8.svg","L","Metade do Skewb em volta do canto de cima atrás, à esquerda: 1/3 de volta (120°) no sentido horário, olhando para o canto.","/imagens/notacao/skewb/7.svg","B'","Metade do Skewb em volta do canto de cima atrás, à direita: 1/3 de volta (120°) no sentido anti-horário.","/imagens/notacao/skewb/6.svg","B","Metade do Skewb em volta do canto de cima atrás, à direita: 1/3 de volta (120°) no sentido horário, olhando para o canto.","/imagens/notacao/skewb/5.svg","R'","Metade do Skewb em volta do canto de cima na frente, à direita: 1/3 de volta (120°) no sentido anti-horário.","/imagens/notacao/skewb/4.svg","R","Metade do Skewb em volta do canto de cima na frente, à direita: 1/3 de volta (120°) no sentido horário, olhando para o canto.","/imagens/notacao/skewb/3.svg","F'","Metade do Skewb em volta do canto de cima na frente, à esquerda: 1/3 de volta (120°) no sentido anti-horário.","/imagens/notacao/skewb/2.svg","F","Metade do Skewb em volta do canto de cima na frente, à esquerda: 1/3 de volta (120°) no sentido horário, olhando para o canto.","/imagens/notacao/skewb/1.svg","id","skewb","Skewb","/skewb/",{"_89":90,"_91":92},"cubos",[95,96,97,98,99,100,101],"idiomas",[93,94],"pt","en",{"_84":109,"_21":109},{"_84":108,"_21":108},{"_84":107,"_21":107},{"_84":106,"_21":106},{"_84":104,"_21":105},{"_84":102,"_21":103},{"_84":85,"_21":86},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2","3x3"]
