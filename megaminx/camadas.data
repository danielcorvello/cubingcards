98,399,400,401],{"_13":392,"_28":397},"/megaminx/treino?grupo=eo,co,ep,cp","/megaminx/ultima-camada",{"_11":454,"_13":455,"_51":404,"_53":456,"_55":56,"_57":457,"_28":458},{"_11":433,"_13":434,"_51":404,"_53":435,"_55":56,"_57":436,"_28":437},{"_11":423,"_13":424,"_51":404,"_53":425,"_55":56,"_57":426,"_28":427},{"_11":402,"_13":403,"_51":404,"_53":405,"_55":56,"_57":406,"_28":407},"Megaminx CP","CP","iniciante",15,[408,409,410,411,412,413,414,415,416,417,418,419,420,421,422],"/megaminx/cp","MEGA-CP1","MEGA-CP2","MEGA-CP3","MEGA-CP4","MEGA-CP5","MEGA-CP6","MEGA-CP7","MEGA-CP8","MEGA-CP9","MEGA-CP10","MEGA-CP11","MEGA-CP12","MEGA-CP13","MEGA-CP14","MEGA-CP15","Megaminx EP","EP",5,[428,429,430,431,432],"/megaminx/ep","MEGA-EP1","MEGA-EP2","MEGA-EP3","MEGA-EP4","MEGA-EP5","Megaminx CO","CO",16,[438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453],"/megaminx/co","MEGA-CO1","MEGA-CO2","MEGA-CO3","MEGA-CO4","MEGA-CO5","MEGA-CO6","MEGA-CO7","MEGA-CO8","MEGA-CO9","MEGA-CO10","MEGA-CO11","MEGA-CO12","MEGA-CO13","MEGA-CO14","MEGA-CO15","MEGA-CO16","Megaminx EO","EO",3,[459,460,461],"/megaminx/eo","MEGA-EO1","MEGA-EO2","MEGA-EO3","f2l","Camadas do meio","<p>As camadas em volta da face branca, de baixo para cima, em 4 passos com fórmulas curtas, até sobrar só a face de cima.</p>\n",[],{"_13":463,"_28":468},"/imagens/diagramas/1a313ab3e7c51322.svg","/megaminx/f2l","estrela","Estrela e 1ª face","<p>A &quot;<a href=\"/glossario#estrela\" class=\"termo-do-glossario\" title=\"No Megaminx, as 5 arestas de uma face no lugar, como a cruz do 3x3. É o primeiro passo (a estrela branca) e, na última camada, a estrela…\">estrela</a>&quot; (as 5 arestas da face branca, como a <a href=\"/glossario#cruz\" class=\"termo-do-glossario\" title=\"As 4 arestas de uma face (em geral a branca) no lugar, alinhadas com os centros. Primeira etapa do método básico e do CFOP.\">cruz</a>) e os 5 cantos brancos, com a pesca <code>DR F DR&#39; F&#39;</code>.</p>\n",[],{"_13":470,"_28":475},"/imagens/diagramas/d6030cd735e065c4.svg","/megaminx/estrela","megaminx","/megaminx/",{"_479":480,"_481":482},"cubos",[485,486,487,488,489,490,491],"idiomas",[483,484],"pt","en",{"_11":499,"_13":499},{"_11":498,"_13":498},{"_11":497,"_13":497},{"_11":496,"_13":496},{"_11":476,"_13":27},{"_11":494,"_13":495},{"_11":492,"_13":493},"skewb","Skewb","pyraminx","Pyraminx","5x5","4x4","2x2","3x3"]
