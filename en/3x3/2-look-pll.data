[{"_1":2,"_3":4},"root",{"_5":112},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":12,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-7,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"tipo","grupo","cubo",{"_11":110,"_13":110,"_39":111},"id","2-Look PLL","nome","nivel","iniciante","conjunto",true,"oQueFaz","PLL in two parts: first the corners (T and Y), then the edges (Ua, Ub, H and Z). It's the way to start before the 21 PLLs.","antes",{"_105":108,"_107":109},"depois",{"_105":106,"_107":-7},"metodos",[102],"etapa","casos",6,"secoes",[47],"termos",{"_43":44},"termo",{"_39":40,"_41":42},"treino","/3x3/treino?grupo=2-look-pll","imprimir","/3x3/imprimir?grupo=2-look-pll","endereco","/en/glossary#dois-look","dica","Doing a step in two parts, with fewer algorithms. 2-Look OLL and 2-Look PLL are the path for those moving from the beginner method to CFOP.","PLL",{"_39":45,"_41":46},"/en/glossary#pll","Permutation of the Last Layer: Puts the last layer pieces in place, after OLL. There are 21 cases, named after letters (T, J, Y…); in 2-Look PLL, 6 cases in two parts.",{"_11":43,"_13":43,"_27":48},[49,50,51,52,53,54],{"_11":95,"_13":96,"_57":97,"_59":-7,"_39":98,"_61":99,"_63":100,"_65":101},{"_11":88,"_13":89,"_57":90,"_59":-7,"_39":91,"_61":92,"_63":93,"_65":94},{"_11":81,"_13":82,"_57":83,"_59":-7,"_39":84,"_61":85,"_63":86,"_65":87},{"_11":74,"_13":75,"_57":76,"_59":-7,"_39":77,"_61":78,"_63":79,"_65":80},{"_11":67,"_13":68,"_57":69,"_59":-7,"_39":70,"_61":71,"_63":72,"_65":73},{"_11":55,"_13":56,"_57":58,"_59":-7,"_39":60,"_61":62,"_63":64,"_65":66},"PLL-Z","PLL Z","nomeCurto","Z","apelido","/3x3/pll/z","imagem","/imagens/casos/3x3/pll/z.svg","primeira","M2 U M2 U M' U2 M2 U2 M'","conjuntos",[],"PLL-Ub","PLL Ub","Ub","/3x3/pll/ub","/imagens/casos/3x3/pll/ub.svg","U2 y2 M2 U' M U2 M' U' M2",[],"PLL-Ua","PLL Ua","Ua","/3x3/pll/ua","/imagens/casos/3x3/pll/ua.svg","U2 y2 M2 U M U2 M' U M2",[],"PLL-H","PLL H","H","/3x3/pll