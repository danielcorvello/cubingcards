[{"_1":2,"_3":4},"root",{"_5":54},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":-7,"_24":-7,"_25":26},"tipo","etapa","cubo",{"_11":52,"_13":52,"_36":53},"id","lse","nome","LSE: the last 6 edges (Roux)","rascunho",false,"html","<p>With just M and U: orient the 6 edges (4a), put UL and UR in place (4b) and finish the 4 of the M slice (4c). Almost everything is intuitive; <a href=\"/en/glossary#eo\" class=\"termo-do-glossario\" title=\"Edge orientation: each edge turned so that it can go to its place without using F and B.\">EO</a> 4a has the cases with algorithms.</p>\n","treino","/3x3/treino?grupo=eo-4a","metodos",[47],"anterior","proximo","grupos",[27],{"_11":28,"_13":28,"_29":30,"_31":32,"_33":16,"_34":35,"_36":37},"EO 4a","nivel","intermediario","casos",9,"conjunto","ids",[38,39,40,41,42,43,44,45,46],"endereco","/3x3/eo-4a","EO4a-All6","EO4a-2Top2Bot","EO4a-Bottom2","EO4a-Top2Front2","EO4a-4Top","EO4a-2TopOpp","EO4a-2TopAdj","EO4a-1Top1Bot","EO4a-2TopAdj2Bot",{"_13":48,"_49":50,"_36":51},"Roux","numero",4,"/3x3/roux#lse","3x3","/3x3/",{"_55":56,"_57":58},"cubos",[61,62,63,64,65,66],"idiomas",[59,60],"pt","en",{"_11":52,"_13":52},{"_11":73,"_13":73},{"_11":72,"_13":72},{"_11":71,"_13":71},{"_11":69,"_13":70},{"_11":67,"_13":68},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2"]
