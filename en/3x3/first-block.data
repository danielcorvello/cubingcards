[{"_1":2,"_3":4},"root",{"_5":37},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-7,"_20":21,"_22":-7,"_23":24,"_25":26},"tipo","etapa","cubo",{"_11":35,"_13":35,"_28":36},"id","primeiro-bloco","nome","1st block (Roux)","rascunho",false,"html","<p>In <a href=\"/en/glossary#roux\" class=\"termo-do-glossario\" title=\"Gilles Roux's method: two 1x2x3 blocks on the sides, CMLL and the last 6 edges (LSE) with the middle layer. It uses few moves.\">Roux</a>, build a 1×2×3 <a href=\"/en/glossary#bloco\" class=\"termo-do-glossario\" title=\"A set of pieces solved together; in Roux, the 1x2x3 blocks on the sides.\">block</a> on the left and another on the right, leaving the middle slice free. It&#39;s all intuitive, like <a href=\"/en/glossary#cfop\" class=\"termo-do-glossario\" title=\"The most used method in competitions: the cross, the 4 F2L pairs, OLL (makes the top face one color) and PLL (puts the top pieces in place).\">CFOP</a>&#39;s intuitive <a href=\"/en/glossary#f2l\" class=\"termo-do-glossario\" title=\"The first two layers. In CFOP, each bottom corner goes together with the middle edge above it (a pair), one pair at a time.\">F2L</a>; the last <a href=\"/en/glossary#par\" class=\"termo-do-glossario\" title=\"A corner and an edge that go together into the same slot in F2L.\">pair</a> of the 2nd block has algorithms (<a href=\"/en/glossary#sbls\" class=\"termo-do-glossario\" title=\"In Roux: finishes the second block (the right one) by inserting the last pair.\">SBLS</a>) for the annoying cases.</p>\n","treino","metodos",[30],"anterior","proximo",{"_13":27,"_28":29},"grupos",[],"2nd block (Roux)","endereco","/3x3/segundo-bloco",{"_13":31,"_32":33,"_28":34},"Roux","numero",1,"/3x3/roux#primeiro-bloco","3x3","/3x3/",{"_38":39,"_40":41},"cubos",[44,45,46,47,48,49],"idiomas",[42,43],"pt","en",{"_11":35,"_13":35},{"_11":56,"_13":56},{"_11":55,"_13":55},{"_11":54,"_13":54},{"_11":52,"_13":53},{"_11":50,"_13":51},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2"]
