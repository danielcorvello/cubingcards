[{"_1":2,"_3":4},"root",{"_5":38},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":-7,"_24":25,"_26":27},"tipo","etapa","cubo",{"_11":36,"_13":36,"_29":37},"id","cruz","nome","Cross","rascunho",false,"html","<p>In <a href=\"/en/glossary#cfop\" class=\"termo-do-glossario\" title=\"The most used method in competitions: the cross, the 4 F2L pairs, OLL (makes the top face one color) and PLL (puts the top pieces in place).\">CFOP</a>, the <a href=\"/en/glossary#cruz\" class=\"termo-do-glossario\" title=\"The 4 edges of one face (usually white) in place, lined up with the centers. The first step of the beginner method and of CFOP.\">cross</a> is built directly on the bottom (without making it on top and flipping the cube). Use the 15 seconds of <a href=\"/en/glossary#inspecao\" class=\"termo-do-glossario\" title=\"The 15 seconds to look at the cube before you start solving, without turning the faces.\">inspection</a> to plan the whole cross before you start; with time, you can plan the first <a href=\"/en/glossary#par\" class=\"termo-do-glossario\" title=\"A corner and an edge that go together into the same slot in F2L.\">pair</a> too. The <a href=\"/en/3x3/training/cross\">cross trainer</a> practices this.</p>\n","treino","/3x3/treino/cruz","metodos",[31],"anterior","proximo",{"_13":28,"_29":30},"grupos",[],"Intuitive F2L","endereco","/3x3/f2l-intuitiva",{"_13":32,"_33":34,"_29":35},"CFOP","numero",1,"/3x3/cfop#cruz","3x3","/3x3/",{"_39":40,"_41":42},"cubos",[45,46,47,48,49,50,51],"idiomas",[43,44],"pt","en",{"_11":36,"_13":36},{"_11":60,"_13":60},{"_11":59,"_13":59},{"_11":58,"_13":58},{"_11":56,"_13":57},{"_11":54,"_13":55},{"_11":52,"_13":53},"skewb","Skewb","pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2"]
