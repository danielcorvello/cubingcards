[{"_1":2,"_3":4},"root",{"_5":119},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":-7,"_18":19,"_20":21,"_22":23,"_24":25},"tipo","metodo","cubo",{"_11":117,"_13":27,"_28":118},"id","top-first","nome","Top-first","nomeLongo","Top-first (layers and L4E)","termo","niveis",[86,48],"introducao","<p>The way to solve the Pyraminx for the first time: by layers, with yellow on the bottom. Tips and centers almost for free, the 3 bottom edges with two 3-move algorithms and the 3 top ones with 5 cases. Open each step with the Pyraminx in your hand.</p>\n","etapas",[32,33,34,35],"historias",[26],{"_13":27,"_28":29,"_30":31},"Pyraminx","endereco","/historia#pyraminx","resumo","The tetrahedron was created and patented by Uwe Mèffert and released by the Japanese company Tomy in 1981, at the height of the Rubik's Cube craze.",{"_11":111,"_13":112,"_38":113,"_40":114,"_42":115,"_43":-7},{"_11":105,"_13":106,"_38":107,"_40":108,"_42":109,"_43":-7},{"_11":76,"_13":77,"_38":78,"_40":79,"_42":80,"_43":81},{"_11":36,"_13":37,"_38":39,"_40":41,"_42":-7,"_43":44},"l4e","Faster: L4E","html","<p>Instead of the whole layer, build just the &quot;V&quot; (the 2 bottom edges that aren&#39;t in front) and solve the last 4 edges at once, with the <a href=\"/en/glossary#l4e\" class=\"termo-do-glossario\" title=\"On the Pyraminx: solves the 4 edges left after building the &quot;V&quot; on the bottom (the centers and 2 first-layer edges).\">L4E</a> cards and the other 10 from <a href=\"/en/glossary#l3e\" class=\"termo-do-glossario\" title=\"On the Pyraminx: with the first layer done, solves the 3 remaining edges.\">L3E</a>.</p>\n","grupos",[45],"pagina","treino","/pyraminx/treino?grupo=l4e",{"_11":46,"_13":46,"_47":48,"_49":50,"_51":52,"_53":54,"_28":55},"Pyraminx L4E","nivel","intermediario","casos",20,"conjunto",false,"ids",[56,57,58,59,60,61,62,63,64,65,66,67,68,69,70,71,72,73,74,75],"/pyraminx/l4e","PYRA-RightPolishFlip","PYRA-LeftPolishFlip","PYRA-SUS","PYRA-AntiSUS","PYRA-GoodNiky","PYRA-GoodSochi","PYRA-SuperSledge","PYRA-SuperHedge","PYRA-BadNiky","PYRA-BadSochi","PYRA-RightSpam","PYRA-LeftSpam","PYRA-BadSledge","PYRA-BadHedge","PYRA-BadSexy","PYRA-BadUgly","PYRA-BadRighty","PYRA-BadLefty","PYRA-DoubleSexy","PYRA-DoubleUgly","l3e","Last layer (L3E)","<p>The 3 top edges: 5 cases, one card for each.</p>\n",[84],{"_13":82,"_28":83},"/pyraminx/treino?grupo=l3e","Last layer","/pyraminx/ultima-camada",{"_11":85,"_13":85,"_47":86,"_49":87,"_51":52,"_53":88,"_28":89},"Pyraminx L3E","iniciante",15,[90,91,92,93,94,95,96,97,98,99,100,101,102,103,104],"/pyraminx/l3e","PYRA-Sune","PYRA-AntiSune","PYRA-LeftyBars","PYRA-RightyBars","PYRA-Sledge","PYRA-Hedge","PYRA-Clockwise","PYRA-Counterclockwise","PYRA-Righty","PYRA-Lefty","PYRA-Sexy","PYRA-LeftSexy","PYRA-2Flip","PYRA-DRFlip","PYRA-4Flip","primeira-camada","1st layer","<p>The 3 bottom edges, with <code>R U R&#39;</code> or its mirror, <code>L&#39; U&#39; L</code>.</p>\n",[],{"_13":106,"_28":110},"/pyraminx/primeira-camada","pontas-e-centros","Tips and centers","<p>The tips turn on their own and the centers only turn in place: a few turns, no algorithm.</p>\n",[],{"_13":112,"_28":116},"/pyraminx/pontas-e-centros","pyraminx","/pyraminx/",{"_120":121,"_122":123},"cubos",[126,127,128,129,130,131],"idiomas",[124,125],"pt","en",{"_11":137,"_13":137},{"_11":136,"_13":136},{"_11":135,"_13":135},{"_11":134,"_13":134},{"_11":132,"_13":133},{"_11":117,"_13":27},"megaminx","Megaminx","5x5","4x4","2x2","3x3"]
