[{"_1":2,"_3":4},"root",{"_5":120},"en/routes/aprender-mais.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14},"destaques",[93,94,95],"canais",[79,80,81],"comunidade",[64,65,66],"referencias",[15,16,17,18,19,20,21,22,23],{"_24":60,"_26":61,"_28":62,"_30":63},{"_24":56,"_26":57,"_28":58,"_30":59},{"_24":52,"_26":53,"_28":54,"_30":55},{"_24":48,"_26":49,"_28":50,"_30":51},{"_24":44,"_26":45,"_28":46,"_30":47},{"_24":40,"_26":41,"_28":42,"_30":43},{"_24":36,"_26":37,"_28":38,"_30":39},{"_24":32,"_26":33,"_28":34,"_30":35},{"_24":25,"_26":27,"_28":29,"_30":31},"id","ruwix","nome","Ruwix","url","https://ruwix.com/","sobre","A wiki of Rubik's Cube and twisty puzzle solutions, with beginner guides for many puzzles.","cstimer","csTimer","https://cstimer.net/","A free browser timer with official-style scrambles for every puzzle, session statistics and training tools.","tao-yu-alg-trainer","Tao Yu's Alg Trainer","https://tao-yu.github.io/Alg-Trainer/","Practice algorithms with a virtual cube, scrambles and a timer, with dozens of sets put together by the community.","cubingapp","CubingApp","https://cubingapp.com/","Algorithm pages for 3x3, 2x2, Pyraminx, Skewb and Square-1, plus rankings and a competition finder.","speedcubedb","SpeedCubeDB","https://www.speedcubedb.com/","A huge database of algorithms for every case, across many puzzles.","cubeskills-site","CubeSkills","https://www.cubeskills.com/tutorials","Feliks Zemdegs' tutorial site with video series and algorithm pages for 3x3, one-handed, 4x4, 5x5, bigger cubes and Megaminx.","jperm-net","jperm.net","https://jperm.net/","J Perm's site with written tutorials for 3x3, 2x2, 4x4, one-handed and blindfolded, plus algorithm sheets and trainers for OLL, PLL, COLL, Winter Variation, 2x2 CLL/EG-1 and 4x4 parity.","speedsolving-wiki","SpeedSolving Wiki","https://www.speedsolving.com/wiki/index.php/Main_Page","A community encyclopedia of methods, algorithm sets and terms, with a beginner's introduction to speedcubing.","wca","World Cube Association","https://www.worldcubeassociation.org/","The body that runs official competitions, with the rules, results, rankings and records.",{"_24":75,"_26":76,"_28":77,"_30":78},{"_24":71,"_26":72,"_28":73,"_30":74},{"_24":67,"_26":68,"_28":69,"_30":70},"wca-competitions","WCA Competitions","https://www.worldcubeassociation.org/competitions","The official calendar of World Cube Association competitions, where you can find an event near you.","r-cubers","r/Cubers","https://www.reddit.com/r/Cubers/","The main cubing community on Reddit, with daily discussion threads, solve critiques, puzzle recommendations and competition news.","speedsolving-forum","SpeedSolving.com Forum","https://www.speedsolving.com/forums/","The oldest English speedcubing forum, started in 2006, with a beginner FAQ and threads on methods, hardware and competitions.",{"_24":90,"_26":49,"_28":91,"_30":92},{"_24":86,"_26":87,"_28":88,"_30":89},{"_24":82,"_26":83,"_28":84,"_30":85},"thecubicle","TheCubicle","https://www.youtube.com/@thecubicleofficial","The official channel of the TheCubicle.com store. Besides cube reviews, it has how-to videos with top cubers, like F2L tips and skill-level series on other puzzles.","kian-mansour","Kian Mansour","https://www.youtube.com/@Kian_Mansour","The go-to English channel for the Roux method: advanced Roux techniques, a full EOLR tutorial, one-handed Roux and the Meyer method for 4x4.","cubeskills","https://www.youtube.com/@CubeSkills","Feliks Zemdegs' tutorial channel. Has an advanced F2L series, 4x4 and 5x5 tips, and one-handed PLL algorithms.",{"_24":113,"_26":114,"_28":115,"_30":116,"_100":117},{"_24":105,"_26":106,"_28":107,"_30":108,"_100":109},{"_24":96,"_26":97,"_28":98,"_30":99,"_100":101},"cubeorithms","Cubeorithms","https://www.youtube.com/@Cubeorithms","Nolan (\"Blue\") combines cubing and animation. His tutorials include how to solve the Megaminx, a Megaminx last layer guide and the Kilominx.","temas",[102,103,104],"Beginner","Megaminx","Other puzzles","z3cubing","Z3Cubing","https://www.youtube.com/@Z3Cubing","Entertaining, informative videos about the Rubik's Cube and many other puzzles. Has a full CFOP tutorial and a recent series of tutorials for 2x2, Pyraminx and Clock.",[110,111,112,104],"CFOP","2x2","Pyraminx","j-perm","J Perm","https://www.youtube.com/@JPerm","One of the best-known cubing teachers in English. Covers beginner to advanced CFOP, 2x2 (including Ortega), 4x4 with the Yau method, blindfolded and fewest moves.",[102,110,111,118,119],"4x4","Blindfolded",{"_121":122,"_123":124},"cubos",[127,128,129,130,131,132],"idiomas",[125,126],"pt","en",{"_24":136,"_26":136},{"_24":111,"_26":111},{"_24":118,"_26":118},{"_24":135,"_26":135},{"_24":134,"_26":103},{"_24":133,"_26":112},"pyraminx","megaminx","5x5","3x3"]
