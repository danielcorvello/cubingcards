[{"_1":2,"_3":4},"root",{"_5":38},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-7,"_20":21,"_22":-7,"_23":-7,"_24":25},"tipo","etapa","cubo",{"_11":35,"_13":36,"_31":37},"id","primeira-camada","nome","1st layer","rascunho",false,"html","<p>The 1st layer is the whole white face (the center and the 4 corners) with the corners matching each other on the sides: on each side, the 2 bottom corners with the same color. The side centers don&#39;t matter yet.</p>\n<div class=\"diagramas\"><figure class=\"diagrama\"><img src=\"/imagens/diagramas/8a1c47fb9160c28a.svg\" alt=\"The goal, seen from below: the white face and, on each side, the 2 bottom corners with the same color.\" width=\"140\" height=\"140\" loading=\"lazy\"><figcaption>The goal, seen from below: the white face and, on each side, the 2 bottom corners with the same color.</figcaption></figure></div>\n<h2>One corner at a time</h2>\n<p>Build it with the white center on the bottom, one corner at a time. The trick: held this way, R (the top front right corner) moves only one bottom corner, the front right one. So, with the empty spot there, R or R&#39; brings in a corner from the top around it without breaking the other bottom corners.</p>\n<div class=\"diagramas\"><figure class=\"diagrama tira\"><ol aria-label=\"R'\"><li><img src=\"/imagens/diagramas/1f843838afdf56df-0.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>R'</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/1f843838afdf56df-1.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"></li></ol><figcaption>The front right corner is on top: R&#39; brings it down, and the other 3 bottom corners stay where they are.</figcaption></figure><figure class=\"diagrama tira\"><ol aria-label=\"R\"><li><img src=\"/imagens/diagramas/18f027f17399c275-0.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>R</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/18f027f17399c275-1.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"></li></ol><figcaption>From the other side: here R brings the corner.</figcaption></figure></div>\n<ol>\n<li>Turn the whole Skewb (y) until the empty spot is at the front right, on the bottom.</li>\n<li>Look for the corner that goes there among the top corners around it. If it lands with its side colors matching the neighbours, done; if it lands twisted, take it out and try the other way (R instead of R&#39;).</li>\n<li>If the corner is on the bottom in the wrong spot, an R takes it out and puts it on top.</li>\n</ol>\n<blockquote>\n<p><strong>Tip:</strong> the bottom corners only need to match each other. If the 1st layer is right but its sides are swapped compared to the centers, that&#39;s fine: the centers are fixed at the end.</p>\n</blockquote>\n","treino","metodos",[26,27],"anterior","proximo","grupos",[],{"_13":33,"_29":30,"_31":34},{"_13":28,"_29":30,"_31":32},"Sarah's Advanced","numero",1,"endereco","/skewb/sarah-advanced#primeira-camada","Sarah's Intermediate","/skewb/sarah#primeira-camada","skewb","Skewb","/skewb/",{"_39":40,"_41":42},"cubos",[45,46,47,48,49,50,51],"idiomas",[43,44],"pt","en",{"_11":59,"_13":59},{"_11":58,"_13":58},{"_11":57,"_13":57},{"_11":56,"_13":56},{"_11":54,"_13":55},{"_11":52,"_13":53},{"_11":35,"_13":36},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2","3x3"]
