[{"_1":2,"_3":4},"root",{"_5":88},"en/routes/notacao.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20},"cubo",{"_84":85,"_21":86,"_23":87},"introducao","The Skewb turns around its corners: each turn moves half of it (a corner, its 3 neighbouring corners and 3 centers), a third of a turn. The apostrophe (') reverses the direction.","comoSegurar","<p>Hold it with the 1st layer on the bottom and yellow on top, as in the algorithms on the cards.</p>\n<ul>\n<li><strong>The letters are the top corners:</strong> R is the front right one, F the front left, L the back left and B the back right. The turn moves the half of the Skewb that contains the corner.</li>\n<li><strong>The direction:</strong> clockwise is looking at the corner from outside, as if it pointed at you. The apostrophe (&#39;) reverses it.</li>\n<li><strong>No 2:</strong> each turn is a third of a turn (120°). Two turns one way are the same as one the other way (R R is the same as R&#39;).</li>\n<li><strong>The two <a href=\"/en/glossary#trigger\" class=\"termo-do-glossario\" title=\"A short sequence that shows up in many algorithms (R U R' U', Sledge…). Memorizing the triggers makes long algorithms easier.\">triggers</a>:</strong> the <a href=\"/en/glossary#sledgehammer\" class=\"termo-do-glossario\" title=\"Two triggers: the sledgehammer is R' F R F' and the hedgeslammer, F R' F' R. On the Skewb, they make up almost every algorithm in Sarah's…\">sledgehammer</a> is R&#39; F R F&#39;; the hedgeslammer, F R&#39; F&#39; R. Almost every algorithm in Sarah&#39;s method is made of them.</li>\n</ul>\n<p><a href=\"/en/glossary#embaralhamento\" class=\"termo-do-glossario\" title=\"A sequence of moves that mixes up the cube before solving. In competitions, everyone gets the same one.\">Scrambles</a> use another <a href=\"/en/glossary#notacao\" class=\"termo-do-glossario\" title=\"The letters that describe the moves: R, U, F… Each cube has its own notation page.\">notation</a>, the <a href=\"/en/glossary#wca\" class=\"termo-do-glossario\" title=\"The association that runs the official competitions and keeps the records.\">WCA</a> one: with white on top and green in front, R, U, L and B turn around 4 corners that never move (R: bottom back right; U: top back left; L: bottom front left; B: bottom back left).</p>\n","basicos",[52,53,54,55,56,57,58,59],"outros",[25,26,27,28,29,30],"treino","/skewb/treino/notacao","metodo",{"_21":22,"_23":24},"nome","Sarah's Intermediate","endereco","/skewb/sarah",{"_31":49,"_33":50,"_35":51,"_37":38},{"_31":47,"_33":34,"_35":48,"_37":38},{"_31":44,"_33":45,"_35":46,"_37":38},{"_31":42,"_33":34,"_35":43,"_37":38},{"_31":39,"_33":40,"_35":41,"_37":38},{"_31":32,"_33":34,"_35":36,"_37":38},"movimento","z'","descricao","Turn the whole Skewb the other way.","imagem","/imagens/notacao/skewb/14.svg","meiaVolta",false,"z","Turn the whole Skewb like F on the 3x3 (the top face goes to the right).","/imagens/notacao/skewb/13.svg","y'","/imagens/notacao/skewb/12.svg","y","Turn the whole Skewb like U on the 3x3 (the right face comes to the front).","/imagens/notacao/skewb/11.svg","x'","/imagens/notacao/skewb/10.svg","x","Turn the whole Skewb like R on the 3x3 (the front goes up).","/imagens/notacao/skewb/9.svg",{"_31":81,"_33":82,"_35":83,"_37":38},{"_31":78,"_33":79,"_35":80,"_37":38},{"_31":75,"_33":76,"_35":77,"_37":38},{"_31":72,"_33":73,"_35":74,"_37":38},{"_31":69,"_33":70,"_35":71,"_37":38},{"_31":66,"_33":67,"_35":68,"_37":38},{"_31":63,"_33":64,"_35":65,"_37":38},{"_31":60,"_33":61,"_35":62,"_37":38},"L'","Half of the Skewb around the top back left corner: 1/3 of a turn (120°) counterclockwise.","/imagens/notacao/skewb/8.svg","L","Half of the Skewb around the top back left corner: 1/3 of a turn (120°) clockwise, looking at the corner.","/imagens/notacao/skewb/7.svg","B'","Half of the Skewb around the top back right corner: 1/3 of a turn (120°) counterclockwise.","/imagens/notacao/skewb/6.svg","B","Half of the Skewb around the top back right corner: 1/3 of a turn (120°) clockwise, looking at the corner.","/imagens/notacao/skewb/5.svg","R'","Half of the Skewb around the top front right corner: 1/3 of a turn (120°) counterclockwise.","/imagens/notacao/skewb/4.svg","R","Half of the Skewb around the top front right corner: 1/3 of a turn (120°) clockwise, looking at the corner.","/imagens/notacao/skewb/3.svg","F'","Half of the Skewb around the top front left corner: 1/3 of a turn (120°) counterclockwise.","/imagens/notacao/skewb/2.svg","F","Half of the Skewb around the top front left corner: 1/3 of a turn (120°) clockwise, looking at the corner.","/imagens/notacao/skewb/1.svg","id","skewb","Skewb","/skewb/",{"_89":90,"_91":92},"cubos",[95,96,97,98,99,100,101],"idiomas",[93,94],"pt","en",{"_84":109,"_21":109},{"_84":108,"_21":108},{"_84":107,"_21":107},{"_84":106,"_21":106},{"_84":104,"_21":105},{"_84":102,"_21":103},{"_84":85,"_21":86},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2","3x3"]
