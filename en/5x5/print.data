_55":54},"movimento","z","descricao","Turn the whole cube like an F (the top face goes to the right).","imagem","/imagens/notacao/5x5/28.svg","meiaVolta",false,"basico","y","Turn the whole cube like a U (the right face comes to the front).","/imagens/notacao/5x5/27.svg","x","Turn the whole cube like an R (the front goes up).","/imagens/notacao/5x5/26.svg","S","Only the middle layer, between F and B, in the direction of F (the top goes to the right).","/imagens/notacao/5x5/25.svg","E","Only the middle layer, between U and D, in the direction of D (the front goes to the right).","/imagens/notacao/5x5/24.svg","M'","Only the middle layer, in the direction of R (the front goes up).","/imagens/notacao/5x5/23.svg","M","On the 5x5, M = only the middle layer, between L and R, in the direction of L (the front goes down).","/imagens/notacao/5x5/22.svg","Bw","The 2 back layers together (B + 2B): a quarter turn like B.","/imagens/notacao/5x5/21.svg","2F","Only the 2nd layer from the front: a quarter turn like F.","/imagens/notacao/5x5/20.svg","Fw'","The 2 front layers together: a quarter turn like F'.","/imagens/notacao/5x5/19.svg","Fw","The 2 front layers together (F + 2F): a quarter turn like F.","/imagens/notacao/5x5/18.svg","Dw","The 2 bottom layers together (D + 2D): a quarter turn like D.","/imagens/notacao/5x5/17.svg","2U'","Only the 2nd layer from the top: a quarter turn like U'.","/imagens/notacao/5x5/16.svg","2U","Only the 2nd layer from the top: a quarter turn like U.","/imagens/notacao/5x5/15.svg","Uw'","The 2 top layers together: a quarter turn like U'.","/imagens/notacao/5x5/14.svg","Uw","The 2 top layers together (U + 2U): a quarter turn like U.","/imagens/notacao/5x5/13.svg","2L'","Only the 2nd layer from the left: a quarter turn like L'.","/imagens/notacao/5x5/12.svg","2L","Only the 2nd layer from the left: a quarter turn like L.","/imagens/notacao/5x5/11.svg","Lw'","The 2 left layers together: a quarter turn like L'.","/imagens/notacao/5x5/10.svg","Lw","The 2 left layers together (L + 2L): a quarter turn like L.","/imagens/notacao/5x5/9.svg","3R","Only the middle layer, in the direction of R: the same as M'.","/imagens/notacao/5x5/8.svg","2R'","Only the 2nd layer from the right: a quarter turn like R'.","/imagens/notacao/5x5/7.svg","2R","Only the 2nd layer from the right (without the outer one): a quarter turn like R.","/imagens/notacao/5x5/6.svg","3Rw'","The 3 right layers together: a quarter turn like R'.","/imagens/notacao/5x5/5.svg","3Rw","The 3 right layers together (R + 2R + the middle one): a quarter turn like R.","/imagens/notacao/5x5/4.svg","Rw'","The 2 right layers together: a quarter turn counterclockwise.","/imagens/notacao/5x5/3.svg","Rw","The 2 right layers together (R + 2R): a quarter turn clockwise. Also written r.","/imagens/notacao/5x5/2.svg","R","Outer right layer, as on the 3x3. On the 5x5, from the outside in: R, 2R, 3R (the middle one), 2L and L.","/imagens/notacao/5x5/1.svg","5X5-L2C1",{"_197":137,"_198":472,"_200":343,"_202":-7,"_51":473,"_204":-7,"_205":474,"_207":475,"_209":476,"_211":-7,"_212":54},"5X5-L2C2",{"_197":139,"_198":459,"_200":343,"_202":-7,"_51":460,"_204":-7,"_205":461,"_207":462,"_209":463,"_211":-7,"_212":54},"5X5-L2C3",{"_197":141,"_198":454,"_200":343,"_202":-7,"_51":455,"_204":-7,"_205":432,"_207":456,"_209":457,"_211":-7,"_212":54},"5X5-L2C4",{"_197":143,"_198":445,"_200":343,"_202":-7,"_51":446,"_204":-7,"_205":447,"_207":448,"_209":449,"_211":-7,"_212":54},"5X5-L2C5",{"_197":145,"_198":438,"_200":343,"_202":-7,"_51":439,"_204":-7,"_205":418,"_207":440,"_209":441,"_211":-7,"_212":54},"5X5-L2C6",{"_197":147,"_198":433,"_200":343,"_202":-7,"_51":434,"_204":-7,"_205":409,"_207":435,"_209":436,"_211":-7,"_212":54},"5X5-L2C7",{"_197":149,"_198":426,"_200":343,"_202":-7,"_51":427,"_204":-7,"_205":428,"_207":429,"_209":430,"_211":-7,"_212":54},"5X5-L2C8",{"_197":151,"_198":419,"_200":343,"_202":-7,"_51":420,"_204":-7,"_205":421,"_207":422,"_209":423,"_211":-7,"_212":54},"5X5-L2C9",{