.svg","y'","Turn the whole Megaminx the other way: the left face comes to the front.","/imagens/notacao/megaminx/24.svg","y","Turn the whole Megaminx like a U (1/5 of a turn): the right face comes to the front.","/imagens/notacao/megaminx/23.svg","D","Bottom face (the one opposite U): 1/5 of a turn (72°) clockwise, looking from below.","/imagens/notacao/megaminx/22.svg","B","Bottom face right at the back (between BR and BL): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/21.svg","DBL","Bottom back left face (between BL and L): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/20.svg","DBR","Bottom back right face (between R and BR): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/19.svg","DL'","DL face (the bottom one between F and L): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/18.svg","DL","DL face (the bottom one between F and L): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/17.svg","DR'","DR face (the bottom one between F and R): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/16.svg","DR","DR face (the bottom one between F and R): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/15.svg","BL'","BL face (the back left one, on top): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/14.svg","BL","BL face (the back left one, on top): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/13.svg","BR'","BR face (the back right one, on top): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/12.svg","BR","BR face (the back right one, on top): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/11.svg","L'","L face (the one to the left of the front, on top): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/10.svg","L","L face (the one to the left of the front, on top): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/9.svg","R'","R face (the one to the right of the front, on top): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/8.svg","R","R face (the one to the right of the front, on top): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/7.svg","F'","F face (the front one, next to U): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/6.svg","F","F face (the front one, next to U): 1/5 of a turn (72°) clockwise, looking at it.","/imagens/notacao/megaminx/5.svg","U'","U face (the top face): 1/5 of a turn (72°) counterclockwise.","/imagens/notacao/megaminx/2.svg","U","U face (the top face): 1/5 of a turn (72°) clockwise, looking from above.","/imagens/notacao/megaminx/1.svg",{"_148":149,"_150":151,"_152":153,"_15":154},"id","camadas","nome","Layers","nivel","iniciante",[155,156,157,158,159,160],"Megaminx EO","Megaminx CO","Megaminx EP","Megaminx CP","Megaminx OLL","Megaminx PLL","resolucao","cronometro","reconhecimento","megaminx","Megaminx","endereco","/megaminx/",{"_169":170,"_171":172},"cubos",[175,176,177,178,179,180],"idiomas",[173,174],"pt","en",{"_148":186,"_150":186},{"_148":185,"_150":185},{"_148":184,"_150":184},{"_148":183,"_150":183},{"_148":164,"_150":165},{"_148":181,"_150":182},"pyraminx","Pyraminx","5x5","4x4","2x2","3x3"]
