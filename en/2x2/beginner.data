[{"_1":2,"_3":4},"root",{"_5":86},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26},"tipo","metodo","cubo",{"_11":84,"_13":84,"_40":85},"id","basico","nome","Beginner method","nomeLongo","Beginner method (layers)","termo",{"_40":81,"_82":83},"niveis",[45],"introducao","<p>The way to solve the 2x2 for the first time: the bottom layer, then the top one, with just two algorithms, the <a href=\"/en/glossary#sune\" class=\"termo-do-glossario\" title=\"Two short OLL algorithms that orient 3 corners: R U R' U R U2 R' (Sune) and R U2 R' U' R U' R' (Anti-Sune).\">Sune</a> and the headlights one. They&#39;re the same as in the 3x3 <a href=\"/en/glossary#basico\" class=\"termo-do-glossario\" title=\"Most people's first method: it solves the cube layer by layer, in 8 steps, with few algorithms. It's slow, but it teaches how the pieces…\">beginner method</a>: if you know the 3x3, you know the 2x2.</p>\n","etapas",[27,28,29],"historias",[],{"_11":74,"_13":75,"_32":76,"_34":77,"_36":78,"_38":-7},{"_11":55,"_13":56,"_32":57,"_34":58,"_36":59,"_38":60},{"_11":30,"_13":31,"_32":33,"_34":35,"_36":37,"_38":39},"cantos","Corners in place","html","<p>The top corners in the right place, by looking for headlights. The end: the cube solved.</p>\n","grupos",[42],"pagina",{"_13":31,"_40":41},"treino","/2x2/treino?grupo=basico/cantos/casos","endereco","/2x2/basico/cantos",{"_11":43,"_13":31,"_44":45,"_46":47,"_48":49,"_50":51,"_40":52},"2x2 Passo 3","nivel","iniciante","casos",2,"conjunto",false,"ids",[53,54],"/2x2/basico/cantos/casos","2X2-B3-Dois-cantos-certos","2X2-B3-Nenhum-par-certo","face-amarela","Yellow face","<p>The top corners with yellow facing up, with the <a href=\"/en/glossary#sune\" class=\"termo-do-glossario\" title=\"Two short OLL algorithms that orient 3 corners: R U R' U R U2 R' (Sune) and R U2 R' U' R U' R' (Anti-Sune).\">Sune</a>.</p>\n",[62],{"_13":56,"_40":61},"/2x2/treino?grupo=basico/face-amarela/casos","/2x2/basico/face-amarela",{"_11":63,"_13":56,"_44":45,"_46":64,"_48":49,"_50":65,"_40":66},"2x2 Passo 2",7,[67,68,69,70,71,72,73],"/2x2/basico/face-amarela/casos","2X2-B2-Peixe-Sune","2X2-B2-Peixe-Anti-Sune","2X2-B2-Cruz-H","2X2-B2-Pi","2X2-B2-Farois","2X2-B2-T","2X2-B2-Gravata","primeira-camada","1st layer","<p>The white corners on the bottom, with the <a href=\"/en/glossary#sexy-move\" class=\"termo-do-glossario\" title=\"The trigger R U R' U', the most common of all.\">sexy move</a> (<code>R U R&#39; U&#39;</code>), and the bottom sides matching.</p>\n",[],{"_13":79,"_40":80},"1st face","/2x2/primeira-face","/en/glossary#basico","dica","Most people's first method: it solves the cube layer by layer, in 8 steps, with few algorithms. It's slow, but it teaches how the pieces…","2x2","/2x2/",{"_87":88,"_89":90},"cubos",[93,94,95,96,97,98],"idiomas",[91,92],"pt","en",{"_11":105,"_13":105},{"_11":84,"_13":84},{"_11":104,"_13":104},{"_11":103,"_13":103},{"_11":101,"_13":102},{"_11":99,"_13":100},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","3x3"]
