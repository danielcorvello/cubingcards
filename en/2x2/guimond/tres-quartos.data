[{"_1":2,"_3":4},"root",{"_5":37},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-7,"_20":21,"_22":-7,"_23":24,"_25":26},"tipo","etapa","cubo",{"_11":35,"_13":35,"_28":36},"id","guimond-tres-quartos","nome","¾ of a face","rascunho",false,"html","<p><a href=\"/en/glossary#guimond\" class=\"termo-do-glossario\" title=\"A 2x2 method: it twists the corners so white and yellow are on top and bottom (mixed), separates the two colors and finishes with Ortega's…\">Guimond</a> doesn&#39;t start with the white face. The first step is smaller: <strong>3 stickers on the bottom, each white or yellow</strong>. They can be mixed: two whites and one yellow is fine, for example. Until the end of orientation, white and yellow count as the same color.</p>\n<div class=\"diagramas\"><figure class=\"diagrama\" data-cubo=\"{&quot;cubo&quot;:&quot;2x2&quot;,&quot;embaralhar&quot;:&quot;R U' R&quot;,&quot;tira&quot;:&quot;&quot;,&quot;modo&quot;:&quot;wy&quot;}\"><img src=\"/imagens/diagramas/0badf958b38cabfc.svg\" alt=\"Good: 3 stickers on the bottom, two white and one yellow. The 4th corner is left for orientation.\" width=\"140\" height=\"140\" loading=\"lazy\"><figcaption>Good: 3 stickers on the bottom, two white and one yellow. The 4th corner is left for orientation.</figcaption></figure></div>\n<h2>Why only 3?</h2>\n<p>The 4th bottom corner goes into the next step: the orientation algorithm fixes it and the top ones at once. Building the whole face would waste turns.</p>\n<h2>How to do it</h2>\n<p>Look for the face that already has the most white or yellow stickers and turn the cube so it&#39;s on the bottom. It almost always has 2, sometimes 3: then it takes one turn, two at most.</p>\n<div class=\"diagramas\"><figure class=\"diagrama\" data-cubo=\"{&quot;cubo&quot;:&quot;2x2&quot;,&quot;embaralhar&quot;:&quot;R U F&quot;,&quot;tira&quot;:&quot;&quot;,&quot;modo&quot;:&quot;wy&quot;}\"><img src=\"/imagens/diagramas/e233b147736d8ffd.svg\" alt=\"Before: 2 stickers on the bottom (one white and one yellow).\" width=\"140\" height=\"140\" loading=\"lazy\"><figcaption>Before: 2 stickers on the bottom (one white and one yellow).</figcaption></figure><figure class=\"diagrama\" data-cubo=\"{&quot;cubo&quot;:&quot;2x2&quot;,&quot;embaralhar&quot;:&quot;R U F R2&quot;,&quot;tira&quot;:&quot;&quot;,&quot;modo&quot;:&quot;wy&quot;}\"><img src=\"/imagens/diagramas/1682cd00f520db51.svg\" alt=\"After `R2`: 3. Done.\" width=\"140\" height=\"140\" loading=\"lazy\"><figcaption>After <code>R2</code>: 3. Done.</figcaption></figure></div>\n<blockquote>\n<p><strong>Tip:</strong> since the step is short, you can plan all of it during <a href=\"/en/glossary#inspecao\" class=\"termo-do-glossario\" title=\"The 15 seconds to look at the cube before you start solving, without turning the faces.\">inspection</a> and still look at the orientation case before you start.</p>\n</blockquote>\n","treino","metodos",[30],"anterior","proximo",{"_13":27,"_28":29},"grupos",[],"Orientation","endereco","/2x2/guimond/orientacao",{"_13":31,"_32":33,"_28":34},"Guimond","numero",1,"/2x2/guimond#tres-quartos","2x2","/2x2/",{"_38":39,"_40":41},"cubos",[44,45,46,47,48,49],"idiomas",[42,43],"pt","en",{"_11":56,"_13":56},{"_11":35,"_13":35},{"_11":55,"_13":55},{"_11":54,"_13":54},{"_11":52,"_13":53},{"_11":50,"_13":51},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","3x3"]
