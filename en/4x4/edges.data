[{"_1":2,"_3":4},"root",{"_5":37},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-7,"_20":21,"_22":23,"_24":-7,"_25":26},"tipo","etapa","cubo",{"_11":35,"_13":35,"_28":36},"id","arestas","nome","Edges","rascunho",false,"html","<p>With the centers done, join the 24 edge pieces into 12 <a href=\"/en/glossary#par\" class=\"termo-do-glossario\" title=\"A corner and an edge that go together into the same slot in F2L.\">pairs</a>. Each pair becomes a 3x3 edge. A single algorithm does all the work: <code>Uw&#39; R U R&#39; F R&#39; F&#39; R Uw</code>.</p>\n<div class=\"diagramas\"><figure class=\"diagrama\"><img src=\"/imagens/diagramas/01219e2163d77033.svg\" alt=\"The goal: the 12 edges paired, with the centers done.\" width=\"140\" height=\"140\" loading=\"lazy\"><figcaption>The goal: the 12 edges paired, with the centers done.</figcaption></figure></div>\n<h2>Find the two halves of an edge</h2>\n<p>Look for two edge pieces with the same colors (green and red, for example). They are the two halves of one edge.</p>\n<h2>Put both in front, at the same height</h2>\n<p>Take both to the middle band, in front: one on the left and the other on the right, <strong>at the same height</strong> (both on the bottom or both on top) and with <strong>the same color facing front</strong>. Use only the outer faces (<code>R</code>, <code>U</code>, <code>F</code>…) for this: they don&#39;t break up the centers or the finished pairs.</p>\n<div class=\"diagramas\"><figure class=\"diagrama\"><img src=\"/imagens/diagramas/f8d0e8db03d7f568.svg\" alt=\"The two green and red halves in front, on the bottom, one on each side, with green facing front.\" width=\"140\" height=\"140\" loading=\"lazy\"><figcaption>The two green and red halves in front, on the bottom, one on each side, with green facing front.</figcaption></figure></div>\n<h2>Do the algorithm</h2>\n<p><code>Uw&#39;</code> joins the two halves on the right, <code>R U R&#39; F R&#39; F&#39; R</code> stores the finished pair and brings another edge to its place, and <code>Uw</code> puts the centers back.</p>\n<div class=\"diagramas\"><figure class=\"diagrama tira\"><ol aria-label=\"Uw' R U R' F R' F' R Uw\"><li><img src=\"/imagens/diagramas/8a64074ffceec613-0.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>Uw'</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-1.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>R</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-2.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>U</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-3.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>R'</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-4.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>F</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-5.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>R'</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-6.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>F'</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-7.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>R</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-8.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"><span class=\"giro\"><code>Uw</code><span aria-hidden=\"true\">→</span></span></li><li><img src=\"/imagens/diagramas/8a64074ffceec613-9.svg\" alt=\"\" width=\"96\" height=\"96\" loading=\"lazy\"></li></ol><figcaption>The green and red pair forms. In this example, the algorithm also joins the other two halves.</figcaption></figure></div>\n<p>Repeat with each edge. When only the last two are left, do the same: with the two right halves in front, at the same height, the algorithm pairs both at once, as in the example.</p>\n<h2>After that</h2>\n<p>The cube is now a big 3x3: go on to the 3x3 part.</p>\n","treino","metodos",[30],"anterior",{"_13":27,"_28":29},"proximo","grupos",[],"Centers","endereco","/4x4/centros",{"_13":31,"_32":33,"_28":34},"Reduction","numero",2,"/4x4/reducao#arestas","4x4","/4x4/",{"_38":39,"_40":41},"cubos",[44,45,46,47,48,49,50],"idiomas",[42,43],"pt","en",{"_11":59,"_13":59},{"_11":58,"_13":58},{"_11":35,"_13":35},{"_11":57,"_13":57},{"_11":55,"_13":56},{"_11":53,"_13":54},{"_11":51,"_13":52},"skewb","Skewb","pyraminx","Pyraminx","megaminx","Megaminx","5x5","2x2","3x3"]
