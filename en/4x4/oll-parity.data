[{"_1":2,"_3":4},"root",{"_5":99},"en/routes/conteudo-do-cubo.tsx",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":12,"_14":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39},"tipo","grupo","cubo",{"_11":97,"_13":97,"_40":98},"id","OLL Parity","nome","nivel","intermediario","conjunto",false,"oQueFaz","With the reduction method, the 4x4 is solved like a 3x3, but a single top double edge can show up flipped on its own, which doesn't exist on the 3x3. This algorithm flips it back.","antes",{"_93":96,"_95":-7},"depois",{"_93":94,"_95":-7},"metodos",[90],"etapa",{"_85":86,"_87":-7},"casos",3,"secoes",[44,45,46],"termos",{},"termo",{"_40":41,"_42":43},"treino","/4x4/treino?grupo=oll-parity","imprimir","/4x4/imprimir?grupo=oll-parity","endereco","/en/glossary#paridade","dica","On the 4x4 (and even cubes), situations that don't exist on the 3x3: a single flipped edge (OLL Parity) or two swapped pieces (PLL Parity).…",{"_11":74,"_13":75,"_28":76},{"_11":63,"_13":64,"_28":65},{"_11":47,"_13":48,"_28":49},"como-a-basic-com-m-antes-e-depois","Like Basic, with M before and after",[50],{"_11":51,"_13":52,"_53":54,"_55":-7,"_40":56,"_57":58,"_59":60,"_61":62},"4X4-OLLP-M","OLL Parity M","nomeCurto","M","apelido","/4x4/oll-parity/m","imagem","/imagens/casos/4x4/oll-parity/m.svg","primeira","M Rw U2 x Rw U2 Rw U2 Rw' U2 Lw U2 Rw' U2 Rw U2 Rw' U2 Rw' M'","conjuntos",[],"pura-so-vira-a-aresta","Pure: only flips the edge",[66],{"_11":67,"_13":68,"_53":69,"_55":-7,"_40":70,"_57":71,"_59":72,"_61":73},"4X4-OLLP-Pure","OLL Parity Pure","Pure","/4x4/oll-parity/pure","/imagens/casos/4x4/oll-parity/pure.svg","2R' U2 2L F2 2L' F2 2R2 U2 2R U2 2R' U2 F2 2R2 F2",[],"vira-a-aresta-e-mexe-na-permutacao-de-cima","Flips the edge and changes the top permutation",[77],{"_11":78,"_13":79,"_53":80,"_55":-7,"_40":81,"_57":82,"_59":83,"_61":84},"4X4-OLLP-Basic","OLL Parity Basic","Basic","/4x4/oll-parity/basic","/imagens/casos/4x4/oll-parity/basic.svg","Rw U2 x Rw U2 Rw U2 Rw' U2 Lw U2 Rw' U2 Rw U2 Rw' U2 Rw'",[],"pagina",{"_13":88,"_40":89},"proxima","Parities","/4x4/paridades",{"_13":91,"_40":92},"Reduction","/4x4/reducao#paridades","texto","Regular OLL and PLL.","link","Centers, paired edges and F2L, as on a 3x3.","4x4","/4x4/",{"_100":101,"_102":103},"cubos",[106,107,108,109,110,111,112],"idiomas",[104,105],"pt","en",{"_11":121,"_13":121},{"_11":120,"_13":120},{"_11":97,"_13":97},{"_11":119,"_13":119},{"_11":117,"_13":118},{"_11":115,"_13":116},{"_11":113,"_13":114},"skewb","Skewb","pyraminx","Pyraminx","megaminx","Megaminx","5x5","2x2","3x3"]
