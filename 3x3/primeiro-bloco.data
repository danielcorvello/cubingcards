[{"_1":2,"_3":4},"root",{"_5":37},"routes/conteudo-do-cubo",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-7,"_20":21,"_22":-7,"_23":24,"_25":26},"tipo","etapa","cubo",{"_11":35,"_13":35,"_28":36},"id","primeiro-bloco","nome","1º bloco (Roux)","rascunho",false,"html","<p>No <a href=\"/glossario#roux\" class=\"termo-do-glossario\" title=\"Método de Gilles Roux: dois blocos 1x2x3 nas laterais, a CMLL e as últimas 6 arestas (LSE) com a camada do meio. Usa poucos movimentos.\">Roux</a>, monte um <a href=\"/glossario#bloco\" class=\"termo-do-glossario\" title=\"Um conjunto de peças resolvidas juntas; no Roux, os blocos 1x2x3 das laterais.\">bloco</a> 1×2×3 à esquerda e outro à direita, deixando a fatia do meio livre. É tudo intuitivo, como a <a href=\"/glossario#f2l\" class=\"termo-do-glossario\" title=\"As duas primeiras camadas. No CFOP, cada canto de baixo vai junto com a aresta do meio que fica sobre ele (um par), um par de cada vez.\">F2L</a> intuitiva do <a href=\"/glossario#cfop\" class=\"termo-do-glossario\" title=\"O método mais usado nas competições: a cruz, os 4 pares da F2L, a OLL (deixa a face de cima de uma cor) e a PLL (põe as peças de cima no…\">CFOP</a>; o último <a href=\"/glossario#par\" class=\"termo-do-glossario\" title=\"Um canto e uma aresta que vão juntos para o mesmo slot na F2L.\">par</a> do 2º bloco tem fórmulas (SBLS) para os casos chatos.</p>\n","treino","metodos",[30],"anterior","proximo",{"_13":27,"_28":29},"grupos",[],"2º bloco (Roux)","endereco","/3x3/segundo-bloco",{"_13":31,"_32":33,"_28":34},"Roux","numero",1,"/3x3/roux#primeiro-bloco","3x3","/3x3/",{"_38":39},"cubos",[40,41,42,43,44,45],{"_11":35,"_13":35},{"_11":52,"_13":52},{"_11":51,"_13":51},{"_11":50,"_13":50},{"_11":48,"_13":49},{"_11":46,"_13":47},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2"]
