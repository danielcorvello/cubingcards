[{"_1":2,"_3":4},"root",{"_5":38},"routes/conteudo-do-cubo",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":-7,"_24":25,"_26":27},"tipo","etapa","cubo",{"_11":36,"_13":36,"_29":37},"id","cruz","nome","Cruz","rascunho",false,"html","<p>No <a href=\"/glossario#cfop\" class=\"termo-do-glossario\" title=\"O método mais usado nas competições: a cruz, os 4 pares da F2L, a OLL (deixa a face de cima de uma cor) e a PLL (põe as peças de cima no…\">CFOP</a>, a <a href=\"/glossario#cruz\" class=\"termo-do-glossario\" title=\"As 4 arestas de uma face (em geral a branca) no lugar, alinhadas com os centros. Primeira etapa do método básico e do CFOP.\">cruz</a> é feita direto embaixo (sem montar em cima e virar). Use os 15 segundos de <a href=\"/glossario#inspecao\" class=\"termo-do-glossario\" title=\"Os 15 segundos para olhar o cubo antes de começar a resolver, sem girar as faces.\">inspeção</a> para planejar a cruz inteira antes de começar; com o tempo, dá para planejar também o primeiro <a href=\"/glossario#par\" class=\"termo-do-glossario\" title=\"Um canto e uma aresta que vão juntos para o mesmo slot na F2L.\">par</a>. O <a href=\"/3x3/treino/cruz\">treino da cruz</a> treina isso.</p>\n","treino","/3x3/treino/cruz","metodos",[31],"anterior","proximo",{"_13":28,"_29":30},"grupos",[],"F2L intuitiva","endereco","/3x3/f2l-intuitiva",{"_13":32,"_33":34,"_29":35},"CFOP","numero",1,"/3x3/cfop#cruz","3x3","/3x3/",{"_39":40},"cubos",[41,42,43,44,45,46],{"_11":36,"_13":36},{"_11":53,"_13":53},{"_11":52,"_13":52},{"_11":51,"_13":51},{"_11":49,"_13":50},{"_11":47,"_13":48},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2"]
