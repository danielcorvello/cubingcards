,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221],"/3x3/f2l-avancado","AF2L-1","AF2L-2","AF2L-3","AF2L-4","AF2L-5","AF2L-6","AF2L-7","AF2L-8","AF2L-9","AF2L-10","AF2L-11","AF2L-12","AF2L-13","AF2L-14","AF2L-15","AF2L-16","AF2L-17","AF2L-18","AF2L-19","AF2L-20","AF2L-21","AF2L-22","AF2L-23","AF2L-24","AF2L-25","AF2L-26","AF2L-27","AF2L-28","AF2L-29","AF2L-30","AF2L-31","AF2L-32","AF2L-33","AF2L-34","AF2L-35","AF2L-36","AF2L-37","AF2L-38","AF2L-39","AF2L-40","AF2L-41","AF2L-42","AF2L-1a","AF2L-2a","AF2L-3a","AF2L-4a","AF2L-5a","AF2L-6a","AF2L-7a","AF2L-8a","AF2L-9a","AF2L-10a","AF2L-11a","AF2L-12a","F2L","iniciante",41,[227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267],"/3x3/f2l","F2L-1","F2L-2","F2L-3","F2L-4","F2L-5","F2L-6","F2L-7","F2L-8","F2L-9","F2L-10","F2L-11","F2L-12","F2L-13","F2L-14","F2L-15","F2L-16","F2L-17","F2L-18","F2L-19","F2L-20","F2L-21","F2L-22","F2L-23","F2L-24","F2L-25","F2L-26","F2L-27","F2L-28","F2L-29","F2L-30","F2L-31","F2L-32","F2L-33","F2L-34","F2L-35","F2L-36","F2L-37","F2L-38","F2L-39","F2L-40","F2L-41","Cruz","/3x3/cruz",{"_13":271,"_272":273,"_39":274},"CFOP","numero",2,"/3x3/cfop#f2l","3x3","/3x3/",{"_278":279},"cubos",[280,281,282,283,284,285],{"_11":275,"_13":275},{"_11":292,"_13":292},{"_11":291,"_13":291},{"_11":290,"_13":290},{"_11":288,"_13":289},{"_11":286,"_13":287},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2"]
