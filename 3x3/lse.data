[{"_1":2,"_3":4},"root",{"_5":54},"routes/conteudo-do-cubo",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":-7,"_24":-7,"_25":26},"tipo","etapa","cubo",{"_11":52,"_13":52,"_36":53},"id","lse","nome","LSE: as últimas 6 arestas (Roux)","rascunho",false,"html","<p>Só com M e U: orientar as 6 arestas (4a), pôr UL e UR no lugar (4b) e terminar as 4 da fatia M (4c). Quase tudo é intuitivo; a <a href=\"/glossario#eo\" class=\"termo-do-glossario\" title=\"Orientação das arestas: cada aresta virada de um jeito que ela pode ir para o lugar sem usar F e B.\">EO</a> 4a tem os casos com fórmulas.</p>\n","treino","/3x3/treino?grupo=eo-4a","metodos",[47],"anterior","proximo","grupos",[27],{"_11":28,"_13":28,"_29":30,"_31":32,"_33":16,"_34":35,"_36":37},"EO 4a","nivel","intermediario","casos",9,"conjunto","ids",[38,39,40,41,42,43,44,45,46],"endereco","/3x3/eo-4a","EO4a-All6","EO4a-2Top2Bot","EO4a-Bottom2","EO4a-Top2Front2","EO4a-4Top","EO4a-2TopOpp","EO4a-2TopAdj","EO4a-1Top1Bot","EO4a-2TopAdj2Bot",{"_13":48,"_49":50,"_36":51},"Roux","numero",4,"/3x3/roux#lse","3x3","/3x3/",{"_55":56},"cubos",[57,58,59,60,61,62],{"_11":52,"_13":52},{"_11":69,"_13":69},{"_11":68,"_13":68},{"_11":67,"_13":67},{"_11":65,"_13":66},{"_11":63,"_13":64},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","2x2"]
