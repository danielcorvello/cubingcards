[{"_1":2,"_3":4},"root",{"_5":785},"routes/conteudo-do-cubo",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-7,"_20":21,"_22":23},"tipo","metodo","cubo",{"_11":783,"_13":783,"_26":784},"id","zz","nome","ZZ","nomeLongo","ZZ (Zbigniew Zborowski)","niveis",[47],"introducao","etapas",[30,31,32],"historias",[24],{"_13":25,"_26":27,"_28":29},"ZB e ZBLL","endereco","/historia#zb","resumo","Em 1981, Lars Petrus propôs orientar as arestas antes, para a última camada sair em um passo só.",{"_11":776,"_13":777,"_35":778,"_37":779,"_39":780,"_40":-7},{"_11":772,"_13":773,"_35":774,"_37":775,"_39":-7,"_40":-7},{"_11":33,"_13":34,"_35":36,"_37":38,"_39":-7,"_40":41},"zzll","Última camada","html","<p>Como as arestas foram orientadas no começo, a <a href=\"/glossario#cruz\" class=\"termo-do-glossario\" title=\"As 4 arestas de uma face (em geral a branca) no lugar, alinhadas com os centros. Primeira etapa do método básico e do CFOP.\">cruz</a> amarela já vem pronta: a <a href=\"/glossario#oll\" class=\"termo-do-glossario\" title=\"Deixa a face de cima toda de uma cor, sem se preocupar com a posição das peças. São 57 casos; na 2-Look OLL, 10 casos em duas partes.\">OLL</a> vira só a dos cantos (7 casos) e depois a <a href=\"/glossario#pll\" class=\"termo-do-glossario\" title=\"Põe as peças da última camada no lugar, depois da OLL. São 21 casos, com nomes de letras (T, J, Y…); na 2-Look PLL, 6 casos em duas partes.\">PLL</a>. Para ir além, a <a href=\"/glossario#zbll\" class=\"termo-do-glossario\" title=\"Resolve a última camada inteira com uma fórmula, quando as arestas de cima já estão orientadas. São centenas de casos.\">ZBLL</a> resolve a última camada inteira de uma vez (472 casos). A ZZLL e a 2GLL são partes menores dela, para situações mais específicas: cada cartão diz o que precisa estar pronto antes.</p>\n","grupos",[42,43,44],"pagina","treino","/3x3/treino?grupo=zzll,2gll,zbll",{"_11":611,"_13":611,"_46":47,"_48":612,"_50":51,"_52":613,"_26":614},{