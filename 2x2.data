 os giros das faces (<code>R</code>, <code>U</code>, <code>F</code>…) e os do cubo inteiro.</p>\n","/2x2/notacao","/2x2/",{"_624":625,"_626":627},"cubos",[630,631,632,633,634,635],"idiomas",[628,629],"pt","en",{"_81":642,"_33":642},{"_81":37,"_33":37},{"_81":641,"_33":641},{"_81":640,"_33":640},{"_81":638,"_33":639},{"_81":636,"_33":637},"pyraminx","Pyraminx","megaminx","Megaminx","5x5","4x4","3x3"]
